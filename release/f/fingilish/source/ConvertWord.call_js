"خاموشش","khvayn":"خواین","bgn":"بگن","srznsh":"سرزنش","syast":"سیاست","drh":"دره","srght":"سرقت","khta":"خطا","khlaf":"خلاف","pny":"پنی","fdral":"فدرال","mybynh":"میبینه","jry":"جری","hsth":"هسته","khvry":"خوری","myzarh":"میذاره","amthansh":"امتحانش","shklat":"شکلات","nyz":"نیز","shby":"شبی","zybay":"زیبای","mrkh":"معرکه","nvysndh":"نویسنده","mtghad":"متقاعد","gzashtym":"گذاشتیم","taght":"طاقت","amdh":"آمده","brt":"برت","bvdsh":"بودش","sath":"ساعته","ghzayy":"غذایی","nabghh":"نابغه","mashynm":"ماشینم","mnzvrm":"منظورم","arvah":"ارواح","rvs":"عروس","mshtrk":"مشترک","andakhtm":"انداختم","fryb":"فریب","msalh":"مساله"};

  // ---------------------------------------------------------------
  // NORMALIZE Latin input: collapse spelling variants to canonical
  // ---------------------------------------------------------------
  function norm(s) {
    s = s.toLowerCase();
    // digraph variants first
    s = s.replace(/x/g, 'kh');
    s = s.replace(/q/g, 'gh');
    s = s.replace(/w/g, 'v');
    // vowel variants
    s = s.replace(/aa/g, 'a');
    s = s.replace(/oo/g, 'o');
    s = s.replace(/ee/g, 'i');
    s = s.replace(/ou/g, 'o');
    // strip repeated chars (saaalam → salam after aa→a)
    s = s.replace(/(.)\1+/g, '$1');
    return s;
  }

  // ---------------------------------------------------------------
  // ALGORITHMIC TRANSLITERATION: handles unknown words (names, etc.)
  // Processes Latin input left-to-right using longest-match digraphs
  // ---------------------------------------------------------------
  function translit(s) {
    s = s.toLowerCase();
    var out = '';
    var i = 0;
    var len = s.length;
    // Digraph table (checked first, longest match)
    var di = {
      'sh':'\u0634','ch':'\u0686','zh':'\u0698','kh':'\u062E',
      'gh':'\u063A','th':'\u062B','ph':'\u0641'
    };
    // Single char table
    var si = {
      'a':'\u0627','b':'\u0628','p':'\u067E','t':'\u062A',
      's':'\u0633','j':'\u062C','h':'\u0647','d':'\u062F',
      'z':'\u0632','r':'\u0631','f':'\u0641','k':'\u06A9',
      'g':'\u06AF','l':'\u0644','m':'\u0645','n':'\u0646',
      'v':'\u0648','w':'\u0648','y':'\u06CC','i':'\u06CC',
      'u':'\u0648','o':'\u0648','e':'\u0647','q':'\u0642',
      'x':'\u062E'
    };
    while (i < len) {
      // Try digraph first
      if (i + 1 < len) {
        var pair = s[i] + s[i+1];
        if (di[pair]) {
          out += di[pair];
          i += 2;
          continue;
        }
      }
      // Single char
      var c = s[i];
      if (si[c]) {
        out += si[c];
      }
      // Skip non-letter chars (pass through numbers, etc.)
      else if (c >= '0' && c <= '9') {
        out += c;
      }
      i++;
    }
    return out || s;
  }

  // ---------------------------------------------------------------
  // MAIN CONVERSION LOGIC
  // ---------------------------------------------------------------

  // Step 1: Extract context (text before cursor)
  // Try multiple methods for compatibility
  var ctx = '';
  try {
    // Modern Keyman 18: OutputTarget has getTextBeforeCaret()
    if (t && typeof t.getTextBeforeCaret === 'function') {
      ctx = t.getTextBeforeCaret();
    }
    // Fallback: if t is an HTML element or has .value
    else if (t && t.value !== undefined) {
      ctx = t.value.substring(0, t.selectionStart || t.value.length);
    }
    // Fallback: try document.activeElement
    else {
      var el = document.activeElement;
      if (el && el.value !== undefined) {
        ctx = el.value.substring(0, el.selectionStart || el.value.length);
      }
    }
  } catch(ex) {
    // Last resort: try KC method on keyboard
    try {
      var k = this;
      if (k && typeof k.KC === 'function') {
        for (var ci = 1; ci <= 30; ci++) {
          var cc = k.KC(ci, 0, t);
          if (!cc || cc === '\x00' || cc === '') break;
          ctx = cc + ctx;
        }
      }
    } catch(ex2) {}
  }

  // Step 2: Find the last Latin word
  var m = ctx.match(/([a-zA-Z]+)$/);
  if (!m) {
    // No Latin word found - just output a space
    try {
      if (t && typeof t.insertTextBeforeCaret === 'function') {
        t.insertTextBeforeCaret(' ');
      } else if (this && typeof this.KO === 'function') {
        this.KO(-1, t, ' ');
      }
    } catch(ex) {}
    return 1;
  }

  var rawWord = m[1];
  var wordLen = rawWord.length;
  var lowerWord = rawWord.toLowerCase();

  // Step 3: Lookup — try raw first, then normalized
  var persian = D[lowerWord];
  if (!persian) {
    var normalized = norm(lowerWord);
    persian = D[normalized];
  }

  // Step 4: If still not found, use algorithmic transliteration
  if (!persian) {
    persian = translit(lowerWord);
  }

  // Step 5: Replace Latin word with Persian + space
  var output = persian + ' ';
  try {
    // Modern Keyman: OutputTarget API
    if (t && typeof t.deleteCharsBeforeCaret === 'function') {
      t.deleteCharsBeforeCaret(wordLen);
      t.insertTextBeforeCaret(output);
    }
    // Compiled keyboard API: KO(deleteCount, target, insertStr)
    else if (this && typeof this.KO === 'function') {
      this.KO(wordLen, t, output);
    }
    // DOM fallback
    else {
      var el = t || document.activeElement;
      if (el && el.value !== undefined) {
        var pos = el.selectionStart || el.value.length;
        el.value = el.value.substring(0, pos - wordLen) + output + el.value.substring(pos);
        el.selectionStart = el.selectionEnd = pos - wordLen + output.length;
      }
    }
  } catch(ex) {
    // Debug: log errors to console
    if (typeof console !== 'undefined') {
      console.error('Fingilish ConvertWord error:', ex);
    }
  }

  return 1;
})
