c
c Fingilish — Phonetic Persian keyboard
c Based on ImportKeyboard 2019-04-15
c Transliteration rules added 2025
c
store(&NAME) 'Phonetic Persian'
store(&VISUALKEYBOARD) 'fingilish.kvks'
store(&BITMAP) 'basic_kbdus.ico'
store(&LAYOUTFILE) 'fingilish.keyman-touch-layout'
store(&COPYRIGHT) '© 2008-2020 SIL International'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS) 'any'

begin Unicode > use(main)

group(main) using keys

c ============================================================
c Fingilish → Persian word-boundary conversion rules
c Top 500 words. Type a word then Space or Enter to convert.
c Rules are longest-first so longer words take priority.
c ============================================================

