<?xml version="1.0"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.245.0</KeymanDeveloperVersion>
    <FileVersion>12.0</FileVersion>
  </System>
  <Options>
    <ExecuteProgram/>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <MSIFileName/>
    <MSIOptions/>
    <FollowKeyboardVersion/>
  </Options>
  <StartMenu>
    <Folder/>
    <Items/>
  </StartMenu>
  <Info>
    <Name URL="">Phonetic Persian</Name>
    <Copyright URL="">© 2008-2020 SIL International</Copyright>
    <Author URL="steadythrone376@gmail.com">Mattin Tasbihgoo</Author>
    <Version URL="1.0"/>
    <Description URL="">This keyboard is designed for the Persian language. It will be
useful for other languages that require phonetic input.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\fingilish.kmx</Name>
      <Description/>
      <CopyLocation>0</CopyLocation>
      <FileType>.kmx</FileType>
    </File>
