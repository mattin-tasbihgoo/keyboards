<?xml version="1.0" encoding="utf-8"?>
<Package>
  <System>
    <KeymanDeveloperVersion>18.0.245.0</KeymanDeveloperVersion>
    <FileVersion>12.0</FileVersion>
  </System>
  <Options>
    <ExecuteProgram></ExecuteProgram>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <MSIFileName></MSIFileName>
    <MSIOptions></MSIOptions>
  </Options>
  <StartMenu>
    <Folder></Folder>
    <Items/>
  </StartMenu>
  <Info>
    <Name URL="">Fingilish Lexical Model</Name>
    <Copyright URL="">© 2024 Mattin Tasbihgoo</Copyright>
    <Author URL="steadythrone376@gmail.com">Mattin Tasbihgoo</Author>
    <Version URL="">1.0</Version>
    <Description URL="">Lexical model for Fingilish phonetic Persian input.</Description>
  </Info>
  <Files>
    <File>
      <Name>..\build\mattin.fa.fingilish.model.js</Name>
      <Description>Fingilish lexical model</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.js</FileType>
    </File>
    <File>
      <Name>words\fingilish.wordlist.tsv</Name>
      <Description>Fingilish wordlist</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.tsv</FileType>
    </File>
    <File>
      <Name>..\LICENSE.md</Name>
      <Description></Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.md</FileType>
    </File>
  </Files>
  <Keyboards/>
  <LexicalModels>
    <LexicalModel>
      <ID>mattin.fa.fingilish</ID>
      <RightToLeft>1</RightToLeft>
      <Languages>
        <Language ID="fa">Persian</Language>
      </Languages>
    </LexicalModel>
  </LexicalModels>
  <Strings/>
</Package>
